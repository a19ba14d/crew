#!/usr/bin/env python3
"""crew-run：无人值守运行 /crew，实时输出可读日志和心跳，并把运行记录存到日志目录。

用法：crew-run [选项] 任务描述 [-- 原样传给 claude 的参数]
      crew-run --resume 日志目录 答复      回答待确认的问题，接着那次运行的会话跑
退出码：0 通过或已回答；1 未通过、无法验证或待确认；2 运行出错、超时、找不到 /crew、结果行不规范或同一目录已有 crew 在跑；
130 手动中断。
只用 Python 标准库。
"""
import argparse
import datetime as dt
import itertools
import json
import os
import queue
import re
import shlex
import shutil
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path

ROLES = {"crew-planner": "规划员", "crew-coder": "开发员", "crew-verifier": "验证员"}
# 最终汇报里的结果行，比如「- **结果**：通过」
RESULT_LINE_RE = re.compile(r"(?m)^[ \t>*_#-]*结果[ \t*_]*[:：].*$")
# 规范的结果行：「结果：」后面只有一个结果词，前后只允许空格、星号、引号、emoji 这类符号。
# 「部分通过」「通过率 0%」「通过（只读任务）」都不算，免得把失败或含糊的结果当成通过
VERDICT_RE = re.compile(r"[ \t>*_#-]*结果[ \t*_]*[:：](?:[^\w\n]|_){0,12}?"
                        r"(未通过|不通过|无法验证|待确认|已回答|通过)(?:[^\w\n]|_)*")
EXIT_CODES = {"通过": 0, "已回答": 0, "未通过": 1, "不通过": 1, "无法验证": 1, "待确认": 1}
CONCLUSION_RE = re.compile(r"(?m)^[ \t>*_#-]*结论[ \t*_]*[:：][ \t*_]*(\S.*)$")
ITEM_RE = re.compile(r"([-*+]|\d+[.)、])\s")
CD_RE = re.compile(r"""^cd\s+(?:"([^"]+)"|'([^']+)'|([^\s;&|]+))\s*(?:&&|;)\s*""")
QUESTION_RE = re.compile(r"\d+[.)、]\s")
JSON_BLOCK_RE = re.compile(r"```json[ \t]*\n(.*?)\n[ \t]*```", re.S)  # 待确认汇报最后附的问题数据
MAX_QUESTIONS, MAX_CHOICES = 4, 4  # Hermes 的 clarify 和 Claude Code 的 AskUserQuestion 都能接受的上限
SCAN_EVERY = 3  # 每隔几秒顺着进程树记一次 claude 子孙进程所在的进程组
STOP_GRACE = 1.0  # 终止时发 TERM 后等几秒再发 KILL。Hermes 停后台进程时只给 2 秒就强杀，
                  # 整个停止过程平时 1.1 秒左右，给机器忙时留出余量


def one_line(text, limit=100):
    text = " ".join(str(text).split())
    return text if len(text) <= limit else text[: limit - 1] + "…"


def last_line(text, limit=80):
    lines = [line.strip() for line in re.sub(r"</?[\w-]+>", "", str(text)).splitlines() if line.strip()]
    return one_line(lines[-1], limit) if lines else "没有输出"


def text_of(content):
    if isinstance(content, list):
        return "\n".join(part.get("text", "") for part in content if isinstance(part, dict))
    return str(content or "")


def parse_json(text):
    try:
        value = json.loads(text)
    except ValueError:
        return {}
    return value if isinstance(value, dict) else {}


def duration(seconds):
    seconds = int(seconds)
    if seconds < 60:
        return f"{seconds}s"
    minutes, seconds = divmod(seconds, 60)
    if minutes < 60:
        return f"{minutes}m{seconds:02d}s"
    hours, minutes = divmod(minutes, 60)
    return f"{hours}h{minutes:02d}m"


def iso(timestamp):
    return dt.datetime.fromtimestamp(timestamp).astimezone().isoformat(timespec="seconds")


def home_short(path):
    home, path = str(Path.home()), str(path)
    return "~" + path[len(home):] if path.startswith(home + os.sep) else path


def project_name(cwd):
    try:
        out = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=cwd,
                             capture_output=True, text=True, timeout=5)
        if out.returncode == 0 and out.stdout.strip():
            return Path(out.stdout.strip()).name
    except (OSError, subprocess.SubprocessError):
        pass
    return cwd.name or "root"


def has(names, name):
    return any(str(item) == name or str(item).endswith(":" + name) for item in names)


def describe(name, inp, cwd):
    """把一次工具调用写成一句话，比如「Bash: go test ./...」「Edit: internal/user/login.go」。"""
    if name == "Bash":
        command = str(inp.get("command", "")).strip()
        found = CD_RE.match(command)
        if found and os.path.realpath(next(g for g in found.groups() if g)) == os.path.realpath(cwd):
            command = command[found.end():]  # 去掉开头的「cd 项目目录 &&」或「cd 项目目录;」，才看得到真正跑的命令
        return "Bash: " + one_line(command)
    path = inp.get("file_path") or inp.get("notebook_path")
    if path:
        rel = os.path.relpath(path, cwd) if os.path.isabs(path) else path
        return f"{name}: {path if rel.startswith('..') else rel}"
    detail = inp.get("pattern") or inp.get("query") or inp.get("url") or inp.get("description") or inp.get("path")
    return f"{name}: {one_line(detail, 80)}" if detail else str(name)


def sections(text):
    """按「## 标题」拆开角色汇报，每节只留有内容的行（去掉「无」）。保留缩进，数条目时好分出嵌套的子条目。"""
    parts, current = {}, None
    for raw in text.splitlines():
        line = raw.rstrip()
        if line.lstrip().startswith("## "):
            current = line.lstrip()[3:].strip()
            parts[current] = []
        elif current is not None and line.strip().lstrip("-* ").strip() not in ("", "无"):
            parts[current].append(line)
    return parts


def count_items(lines):
    """只数顶层条目，缩进更深的子条目不算：规划员常在一个文件下面再分几条写具体改动。"""
    indents = [len(line) - len(line.lstrip()) for line in lines if ITEM_RE.match(line.lstrip())]
    top = min(indents, default=0)
    return sum(indent == top for indent in indents)


def key_line(report):
    """从角色汇报里挑最关键的一句：验证员的结论、规划员的难度、开发员改了几处。"""
    parts = sections(report)
    found = CONCLUSION_RE.search(report)
    if found:
        problems = count_items(parts.get("问题", []))
        return "结论：" + one_line(found.group(1).strip("* "), 40) + (f"，问题 {problems} 个" if problems else "")
    if parts.get("难度"):
        bits = ["难度 " + one_line(parts["难度"][0].lstrip("-* ").rstrip("。"), 50)]
        changes = count_items(parts.get("改动清单", []))
        bits.append(f"改动 {changes} 处" if changes else "没有改动")
        asks = parts.get("待确认", [])
        # 编号的是问题，「-」是选项；选项没缩进时也不会数成问题
        asked = sum(bool(QUESTION_RE.match(line.lstrip())) for line in asks) or count_items(asks)
        if asked:
            bits.append(f"待确认 {asked} 项")
        return "，".join(bits)
    if "已改动" in parts:
        bits = [f"已改动 {count_items(parts['已改动'])} 处"]
        for name, label, unit in (("计划外改动", "计划外", "处"), ("未完成或拿不准", "拿不准", "项")):
            if count_items(parts.get(name, [])):
                bits.append(f"{label} {count_items(parts[name])} {unit}")
        return "，".join(bits)
    return one_line(next((line for line in report.splitlines() if line.strip()), "（空）"), 80)


def ask_list(items):
    """把一组问题整理成 Hermes clarify 的 questions 参数那种格式；不规范返回 None。"""
    if not isinstance(items, list) or len(items) > MAX_QUESTIONS:
        return None
    questions = []
    for item in items:
        if not isinstance(item, dict):
            return None
        text, choices = item.get("question"), item.get("choices") or []
        if not isinstance(text, str) or not text.strip() or not isinstance(choices, list):
            return None
        choices = [choice.strip() for choice in choices if isinstance(choice, str) and choice.strip()]
        if len(choices) == 1 or len(choices) > MAX_CHOICES:
            return None
        question = {"question": text.strip()}
        if choices:
            question["choices"] = choices
        if item.get("multi_select") is True:
            question["multi_select"] = True
        questions.append(question)
    return questions


def asks_of(report):
    """待确认汇报最后那段 json 里的两类问题：questions 要用户拍板，evidence 要启动 crew 的一方自己去查清。
    返回 (questions, evidence)，没有的那一类是空列表；没有 json、不规范或两类都空返回 None。"""
    blocks = JSON_BLOCK_RE.findall(report)
    data = parse_json(blocks[-1]) if blocks else {}
    questions, evidence = ask_list(data.get("questions", [])), ask_list(data.get("evidence", []))
    if questions is None or evidence is None or len(questions) + len(evidence) == 0:
        return None
    return questions, evidence


def read_status(path):
    try:
        return parse_json(Path(path).read_text(encoding="utf-8"))
    except OSError:
        return {}


def running_here(root, cwd):
    """日志根目录里还在跑、项目目录也相同的那次运行；状态没来得及更新、进程其实已经不在的不算。"""
    for path in sorted(root.glob("*/status.json")):
        status = read_status(path)
        pid = status.get("pid")
        if status.get("state") != "running" or status.get("cwd") != str(cwd) or not isinstance(pid, int):
            continue
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            continue
        except PermissionError:  # 进程在，只是不归我们管
            pass
        return path.parent
    return None


def pump(stream, lines):
    for line in stream:
        lines.put(line)
    lines.put(None)


def process_groups(root):
    """root 和它所有子孙进程所在的进程组。Claude Code 的 Bash 工具会把每条命令放进单独的进程组，
    只终止 claude 自己的进程组管不到正在跑的测试、服务，所以要顺着进程树找。"""
    try:
        out = subprocess.run(["ps", "-A", "-o", "pid=,ppid=,pgid="], capture_output=True, text=True,
                             timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return set()
    children, group = {}, {}
    for line in out.splitlines():
        fields = line.split()
        if len(fields) == 3 and all(field.isdigit() for field in fields):
            pid, ppid, pgid = map(int, fields)
            children.setdefault(ppid, []).append(pid)
            group[pid] = pgid
    found, todo, seen = set(), [root], set()
    while todo:
        pid = todo.pop()
        if pid not in seen:
            seen.add(pid)
            found.add(group.get(pid))
            todo.extend(children.get(pid, []))
    own = os.getpgrp()
    return {pgid for pgid in found if pgid and pgid > 1 and pgid != own}


def group_exists(pgid):
    try:
        os.killpg(pgid, 0)
    except OSError:  # 组里已经没有进程，或者没有权限管
        return False
    return True


def ignore_signals():
    """收尾阶段不再理会中断信号：终止进程加写状态不到两秒，被打断反而会留下残局。"""
    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, signal.SIG_IGN)


class Run:
    def __init__(self, args, task, extra, root, resumed_from=None, resume_session=None, cost_base=0.0):
        self.args, self.task, self.extra = args, task, extra
        self.mode = args.permission_mode or "bypassPermissions"
        self.resumed_from, self.resume_session = resumed_from, resume_session
        self.cost_base = cost_base  # 续跑时会话之前那些轮的累计费用
        self.cwd = Path.cwd()
        self.project = project_name(self.cwd)
        name = f"{self.project}-{dt.datetime.now():%Y%m%d-%H%M%S}"
        for n in itertools.count(1):  # 同一秒启动两次也不共用目录
            self.dir = root / (name if n == 1 else f"{name}-{n}")
            try:
                self.dir.mkdir(parents=True)
                break
            except FileExistsError:
                continue
        (self.dir / "handoffs").mkdir()
        self.log = open(self.dir / "run.log", "a", encoding="utf-8", buffering=1)
        self.events = open(self.dir / "events.jsonl", "a", encoding="utf-8", buffering=1)
        self.proc = None
        self.groups = set()      # claude 和它子孙进程所在的进程组，终止和清理时用
        self.last_scan = 0.0
        self.start = self.last_event = self.last_print = self.last_said = self.last_tick = time.time()
        self.started = self.model_shown = self.stall_warned = False
        self.timed_out = self.interrupted = self.no_skill = self.stopped = False
        self.handoffs = 0
        self.role_of_tool = {}   # 调度员的 Agent 调用 id → 角色，子代理的事件靠它认人
        self.role_of_agent = {}  # 子代理的 agentId → 角色，续用时靠它认人
        self.sends = {}          # 调度员的 SendMessage 调用 id → 角色
        self.running = {}        # 还没结束的工具调用或子代理 → (角色, 动作或 None, 开始时间)
        self.outputs = []        # 每一轮结束时的非空输出；最终汇报是最后一段带「结果」行的
        self.final_is_error = False
        self.error = ""          # claude 报的错误类型，比如 error_max_turns
        self.session_cost = self.session_id = self.verdict = self.exit_code = None
        # 待确认时：要用户拍板的问题、要启动 crew 的一方查清的事、接着跑的命令
        self.questions = self.evidence = self.resume_cmd = None
        self.state = "running"

    # ---------- 输出 ----------

    def say(self, who, text, heartbeat=False):
        pad = " " * max(1, 7 - sum(2 if ord(ch) > 0x2E80 else 1 for ch in who))
        line = f"{time.strftime('%H:%M:%S')} {who}{pad}{text}"
        print(line, flush=True)
        self.log.write(line + "\n")
        self.last_print = time.time()
        if not heartbeat:
            self.last_said = self.last_print

    def save_handoff(self, title, text):
        self.handoffs += 1
        path = self.dir / "handoffs" / f"{self.handoffs:02d}-{title}.md"
        path.write_text(str(text).rstrip() + "\n", encoding="utf-8")

    def current(self, now):
        actions = [item for item in self.running.values() if item[1]]
        if actions:
            role, action, since = max(actions, key=lambda item: item[2])
            return f"{role}在跑 {action}（已 {duration(now - since)}）"
        workers = [item for item in self.running.values() if not item[1]]
        role = max(workers, key=lambda item: item[2])[0] if workers else "调度员"
        return f"{role}在思考（已 {duration(now - self.last_said)}）"

    def run_cost(self):
        """这次运行的费用。续跑时 claude 报的是整个会话的累计费用，要减掉之前那些轮的。"""
        if self.session_cost is None:
            return None
        return self.session_cost - self.cost_base if self.session_cost >= self.cost_base else self.session_cost

    def write_status(self):
        now = time.time()
        status = {
            "state": self.state, "verdict": self.verdict, "exit_code": self.exit_code,
            "task": self.task, "project": self.project, "cwd": str(self.cwd), "run_dir": str(self.dir),
            "pid": self.proc.pid if self.proc else None, "session_id": self.session_id,
            "resumed_from": str(self.resumed_from) if self.resumed_from else None,
            "permission_mode": self.mode, "claude_args": self.extra,
            "started_at": iso(self.start), "updated_at": iso(now), "elapsed_s": int(now - self.start),
            "last_event_at": iso(self.last_event),
            "current": self.current(now) if self.state == "running" else None,
            "cost_usd": self.run_cost(), "session_cost_usd": self.session_cost,
            "questions": self.questions, "evidence": self.evidence, "resume": self.resume_cmd,
        }
        tmp = self.dir / "status.json.tmp"
        tmp.write_text(json.dumps(status, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        os.replace(tmp, self.dir / "status.json")

    # ---------- 心跳、卡住、超时 ----------

    def tick(self):
        now = self.last_tick = time.time()
        args = self.args
        if args.heartbeat and now - self.last_print >= args.heartbeat:
            self.say("♥", f"已运行 {duration(now - self.start)}，{self.current(now)}", heartbeat=True)
        if args.stall and not self.stall_warned and now - self.last_event >= args.stall * 60:
            self.stall_warned = True
            self.say("⚠", f"已经 {duration(now - self.last_event)} 没有任何事件，进程还在，可能卡住了")
        if self.proc.poll() is None and now - self.last_scan >= SCAN_EVERY:
            self.scan_groups()
        over = args.timeout and now - self.start >= args.timeout * 60
        if over and not self.timed_out and self.proc.poll() is None:  # claude 已经自己退出的，不算超时
            self.timed_out = True
            self.say("超时", f"超过 {args.timeout:g} 分钟上限，终止运行")
            self.stop()
        self.write_status()

    def stop(self):
        """终止运行（超时、中断、找不到 /crew 时）：连同 claude 启动的进程一起终止，只做一次。"""
        if self.proc and not self.stopped:
            self.stopped = True
            self.kill_tree()

    def scan_groups(self):
        """顺着进程树补记 claude 子孙进程所在的进程组。命令跑完以后，它丢在后台的进程会脱离进程树，
        所以运行中要定期记，不能等到终止时才找。"""
        self.last_scan = time.time()
        self.groups |= process_groups(self.proc.pid)
        return self.alive_groups()

    def alive_groups(self):
        """记下的进程组里还有进程的那些。先回收已经退出的 claude，免得它的僵尸进程让它的组看起来还在。"""
        self.proc.poll()
        self.groups = {pgid for pgid in self.groups if group_exists(pgid)}
        return self.groups

    def kill_tree(self):
        """终止 claude 和它启动的所有进程，包括 Bash 工具放在别的进程组里的测试、服务：
        先发 TERM，最多等 STOP_GRACE 秒，还没退的发 KILL。不能只看 claude 自己退没退：
        不理 TERM 的子进程会一直跑，还可能占着输出管道让 crew-run 卡住。"""
        for sig, wait in ((signal.SIGTERM, STOP_GRACE), (signal.SIGKILL, 5)):
            # claude 还活着时进程树是完整的，发信号前再找一遍
            for pgid in self.scan_groups() if self.proc.poll() is None else self.alive_groups():
                try:
                    os.killpg(pgid, sig)
                except OSError:
                    pass
            deadline = time.time() + wait
            try:
                while self.alive_groups() and time.time() < deadline:
                    time.sleep(0.05)  # 查得勤一点：整个停止过程要赶在 Hermes 的 2 秒强杀之前做完
            except KeyboardInterrupt:  # 等的时候又按了一次 Ctrl-C：不等了，直接 KILL
                continue
            if not self.groups:
                return

    def clean_leftovers(self):
        """claude 自己退出后，它启动的进程 2 秒内还没退的，一并清理，免得一直在跑或者占着输出管道。"""
        deadline = time.time() + 2
        while self.alive_groups():
            if time.time() >= deadline:
                self.say("⚠", "claude 已经退出，它启动的进程还有没退的，一并清理")
                self.kill_tree()
                return
            time.sleep(0.2)

    # ---------- 解析事件流 ----------

    def feed(self, line):
        self.events.write(line)
        self.last_event, self.stall_warned = time.time(), False
        if not line.lstrip().startswith("{"):  # 不是事件就原样转出来，比如 claude 直接打印的报错
            if line.strip():
                self.say("claude", one_line(line, 160))
            return
        try:
            event = json.loads(line)
            if isinstance(event, dict):
                self.handle(event)
        except Exception as exc:  # 事件格式变了也不能让日志中断
            self.say("⚠", f"有一行事件解析失败：{type(exc).__name__}: {one_line(exc, 80)}")

    def handle(self, event):
        kind, sub = event.get("type"), event.get("subtype")
        parent = event.get("parent_tool_use_id")
        if kind == "system" and sub == "init":
            if not self.started:  # 每开一轮都会再来一个 init，只看第一个
                self.started = True
                self.on_init(event)
        elif kind == "assistant":
            message = event.get("message") or {}
            who = self.role_of_tool.get(parent, "子代理") if parent else "调度员"
            model = str(message.get("model") or "")
            if not parent and not self.model_shown and model and not model.startswith("<"):
                self.model_shown = True  # skill 里设的模型以这里为准，init 里的是会话默认模型
                self.say("调度员", f"模型 {model}")
            for block in message.get("content") or []:
                if not isinstance(block, dict):
                    continue
                if block.get("type") == "tool_use":
                    self.on_tool_use(who, bool(parent), block)
                elif block.get("type") == "text" and not parent and (block.get("text") or "").strip():
                    self.show_text(block["text"])
        elif kind == "user":
            content = (event.get("message") or {}).get("content")
            for block in content if isinstance(content, list) else []:
                if isinstance(block, dict) and block.get("type") == "tool_result":
                    self.on_tool_result(block)
        elif kind == "system" and sub == "task_started":
            tool_id, task_id = event.get("tool_use_id"), event.get("task_id")
            role = self.role_of_tool.get(tool_id) or self.sends.get(tool_id) or ROLES.get(event.get("subagent_type"))
            if role:
                # task_id 就是 agentId；续用的子代理没有新的 Agent 调用，只能从这里知道它又开始干活了
                self.role_of_agent.setdefault(task_id, role)
                self.running[task_id] = (role, None, time.time())
        elif kind == "system" and sub == "task_notification":
            self.running.pop(event.get("task_id"), None)
        elif kind == "rate_limit_event":
            status = (event.get("rate_limit_info") or {}).get("status")
            if status and status != "allowed":
                self.say("⚠", f"用量限制：{status}")
        elif kind == "result":
            # 续用子代理时，调度员会先结束一轮、等汇报回来再开一轮，所以会有多个 result，每段非空的都留着
            self.session_id = event.get("session_id") or self.session_id
            if isinstance(event.get("total_cost_usd"), (int, float)):
                self.session_cost = event["total_cost_usd"]
            text = event.get("result") or ""
            if text.strip():
                self.outputs.append(text)
                self.final_is_error = bool(event.get("is_error"))
            elif event.get("is_error"):
                self.final_is_error = True
            if event.get("is_error"):
                self.error = event.get("subtype") or "error"

    def show_text(self, text):
        """调度员说的话逐行显示，最多 5 行。最终汇报在结束时整段输出，这里跳过。"""
        if RESULT_LINE_RE.search(text):
            return
        lines = [one_line(re.sub(r"\*\*|`", "", raw), 120) for raw in text.splitlines()]
        lines = [line for line in lines if line]
        for line in lines[:5]:
            self.say("调度员", line)
        if len(lines) > 5:
            self.say("调度员", f"……还有 {len(lines) - 5} 行，见 events.jsonl")

    def on_init(self, event):
        self.session_id = event.get("session_id")
        commands, agents = event.get("slash_commands"), event.get("agents")
        if commands is not None and not has(commands, "crew"):
            self.no_skill = True
            self.say("出错", "这个会话里没有 /crew：先安装 skill，或者到装了 skill 的项目目录里运行")
            self.stop()
            return
        missing = [name for name in ROLES if agents is not None and not has(agents, name)]
        if missing:
            self.say("⚠", "缺少角色定义：" + "、".join(missing) + "，先把 agents/ 下的文件装好")

    def on_tool_use(self, who, in_subagent, block):
        name, inp, tool_id = block.get("name"), block.get("input") or {}, block.get("id")
        if name == "ToolSearch":
            return
        if not in_subagent and name == "Agent":
            role = ROLES.get(inp.get("subagent_type"), inp.get("subagent_type") or "子代理")
            self.role_of_tool[tool_id] = role
            self.running[tool_id] = (role, None, time.time())
            self.say("调度员", f"→ {role}（{inp.get('model') or '默认模型'} / {inp.get('effort') or '默认思考程度'}）")
            self.save_handoff(f"派给{role}", inp.get("prompt", ""))
        elif not in_subagent and name == "SendMessage":
            role = self.role_of_agent.get(inp.get("to"), "子代理")
            self.sends[tool_id] = role
            self.running[tool_id] = (role, None, time.time())
            self.say("调度员", f"→ {role}（续用上一轮的{role}）")
            self.save_handoff(f"发给{role}", inp.get("message", ""))
        elif in_subagent and name == "SubagentHandback":
            report = str(inp.get("message", ""))
            self.say(who, f"→ 调度员：{key_line(report)}")
            self.save_handoff(f"{who}汇报", report)
        else:
            action = describe(name, inp, self.cwd)
            self.running[tool_id] = (who, action, time.time())
            self.say(who, action)

    def on_tool_result(self, block):
        tool_id = block.get("tool_use_id")
        item = self.running.pop(tool_id, None)
        body = text_of(block.get("content"))
        if tool_id in self.sends:
            reply = parse_json(body)
            if reply.get("success") is False:
                self.say("⚠", f"续用{self.sends[tool_id]}失败：{one_line(reply.get('message') or body, 100)}")
        elif tool_id in self.role_of_tool:
            found = re.search(r"agentId:\s*([0-9a-z]+)", body)
            if found:
                self.role_of_agent.setdefault(found.group(1), self.role_of_tool[tool_id])
        if block.get("is_error") and item:
            role, action, _ = item
            self.say(role, f"✗ {action}：{last_line(body)}" if action else f"✗ 出错：{last_line(body)}")

    # ---------- 主流程 ----------

    def save_baseline(self):
        """工作区开始前就有改动时提示一句，并把已跟踪文件的改动存成 baseline.diff，万一被动了还能找回来。"""
        try:
            status = subprocess.run(["git", "status", "--short"], cwd=self.cwd, capture_output=True,
                                    text=True, timeout=10)
            if status.returncode != 0 or not status.stdout.strip():
                return
            diff = subprocess.run(["git", "diff", "--binary", "HEAD"], cwd=self.cwd, capture_output=True,
                                  timeout=30)
        except (OSError, subprocess.SubprocessError):
            return
        note = ""
        if diff.returncode == 0 and diff.stdout:
            (self.dir / "baseline.diff").write_bytes(diff.stdout)
            note = "，已跟踪文件的改动存到了 baseline.diff"
        count = len(status.stdout.splitlines())
        self.say("⚠", f"工作区开始前就有 {count} 处没提交的改动{note}；最好先提交或 stash 再跑")

    def run(self):
        bypass = self.mode == "bypassPermissions"
        cmd = ["claude", "-p", f"/crew {self.task}", "--output-format", "stream-json", "--verbose"]
        cmd += ["--resume", self.resume_session] if self.resume_session else []
        cmd += ["--dangerously-skip-permissions"] if bypass else ["--permission-mode", self.mode]
        cmd += self.extra
        where = f"项目 {self.project}，{'跳过权限检查' if bypass else '权限模式 ' + self.mode}，日志 {home_short(self.dir)}"
        if self.resumed_from:
            # 工作区里已经有上一轮 crew 自己的改动，不再当成开始前的改动记录；调度员在会话里记得原来的记录
            self.say("续跑", f"接着 {home_short(self.resumed_from)} 的会话，{where}")
        else:
            self.say("启动", where)
            self.save_baseline()
        stderr = open(self.dir / "stderr.log", "w", encoding="utf-8")
        self.proc = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=stderr,
                                     text=True, encoding="utf-8", errors="replace", start_new_session=True)
        self.groups = {self.proc.pid}  # claude 是自己进程组的组长
        self.write_status()
        lines = queue.Queue()
        threading.Thread(target=pump, args=(self.proc.stdout, lines), daemon=True).start()
        eof, exited_at = False, None
        try:
            while True:
                try:
                    line = lines.get(timeout=1)
                except queue.Empty:
                    line = ""
                if line is None:
                    eof = True
                elif line:
                    self.feed(line)
                if time.time() - self.last_tick >= 1:
                    self.tick()  # claude 关了输出但还没退出时，也照样心跳、检查超时
                if self.proc.poll() is None:
                    continue
                if exited_at is None:
                    if not self.stopped:
                        self.clean_leftovers()
                    exited_at = time.time()
                # 输出读完就收尾；脱离了进程组的进程还占着输出管道时，最多再等 5 秒
                if eof:
                    break
                if time.time() - exited_at >= 5:
                    self.say("⚠", "claude 已经退出，输出管道还被别的进程占着（可能是自己脱离了进程组的后台进程），不再等了")
                    break
        except KeyboardInterrupt:
            ignore_signals()
            self.interrupted = self.stopped = True
            self.state, self.exit_code = "interrupted", 130
            self.write_status()  # 先记下状态：Hermes 这类进程管理器 2 秒后就强杀，等不到最后再写
            self.say("中断", "收到中断信号，终止运行")
            self.kill_tree()
        stderr.close()
        return self.finish()

    def finish(self):
        ignore_signals()
        # 最终汇报取最后一段带「结果」行的输出：汇报之后，调度员可能还会回别的话
        report = next((text for text in reversed(self.outputs) if RESULT_LINE_RE.search(text)),
                      self.outputs[-1] if self.outputs else "")
        if report:
            (self.dir / "result.md").write_text(report.rstrip() + "\n", encoding="utf-8")
            print("\n" + report.rstrip() + "\n", flush=True)
            self.log.write("\n" + report.rstrip() + "\n\n")
        line = RESULT_LINE_RE.search(report)
        found = VERDICT_RE.fullmatch(line.group(0).strip()) if line else None
        code = self.proc.poll()
        if self.interrupted:
            self.state, self.exit_code, summary = "interrupted", 130, "已中断"
        elif self.timed_out:
            self.state, self.exit_code, summary = "timeout", 2, "超时终止"
        elif self.no_skill:
            self.state, self.exit_code, summary = "error", 2, "找不到 /crew"
        elif code != 0 or self.final_is_error or not report:
            # claude 没有正常结束，汇报里写什么都不算数，交给人看
            err = (self.dir / "stderr.log").read_text(encoding="utf-8", errors="replace").strip()
            exit_note = ("claude 没有退出" if code is None else f"claude 被信号 {-code} 终止" if code < 0
                         else f"claude 退出码 {code}" if code else "")
            bits = [exit_note, self.error, last_line(err, 120) if err else ""]
            summary = "运行出错（" + ("，".join(bit for bit in bits if bit) or "没有最终汇报") + "）"
            if found:
                summary += f"，汇报里写的是「{found.group(1)}」，需要人工核对"
            self.state, self.exit_code = "error", 2
        elif not line:
            self.state, self.exit_code, summary = "error", 2, "最终汇报里没有「结果」行"
        elif not found:
            self.state, self.exit_code = "error", 2
            summary = f"结果行不规范：{one_line(line.group(0).strip(), 60)}"
        else:
            self.verdict = found.group(1)
            self.state, self.exit_code, summary = "done", EXIT_CODES[self.verdict], self.verdict
        if self.verdict == "待确认":
            questions, evidence = asks_of(report) or (None, None)
            self.questions, self.evidence = questions or None, evidence or None
            self.resume_cmd = f"crew-run --resume {shlex.quote(str(self.dir))}"
            for name, items in (("questions", self.questions), ("evidence", self.evidence)):
                if items:  # 两类分开存：questions.json 可以原样交给 clarify，evidence.json 不是给用户选的
                    (self.dir / f"{name}.json").write_text(
                        json.dumps({name: items}, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        cost = self.run_cost()
        if cost is None:
            cost = ""
        elif cost == self.session_cost:
            cost = f"，${cost:.2f}"
        else:  # 续跑：这次的和整个会话累计的分开写
            cost = f"，这次 ${cost:.2f}，会话累计 ${self.session_cost:.2f}"
        self.say("结束", f"{summary}，用时 {duration(time.time() - self.start)}{cost}，日志 {home_short(self.dir)}")
        if self.verdict == "待确认":
            # 这几行会进到调用方的结束通知里。只看退出码的调用方（比如 Hermes 的后台任务通知）
            # 会把待确认显示成失败、建议重跑，所以先把话说死
            self.say("提示", "这不是失败，不要重跑：crew 停下来等答复，会话和已经做的改动都留着")
            bits = []
            if self.questions:
                bits.append(f"有 {len(self.questions)} 个问题要用户拍板，见 questions.json")
            if self.evidence:
                bits.append(f"有 {len(self.evidence)} 件事要先查清，见 evidence.json（由启动 crew 的一方去查，不要拿去问用户）")
            self.say("提示", "；".join(bits) or "问题见上面的汇报（汇报里没有规范的问题数据，没生成 questions.json 和 evidence.json）")
            self.say("提示", f"答复后接着跑：{self.resume_cmd} \"答复\"")
        self.write_status()
        self.log.close()
        self.events.close()
        return self.exit_code


def main():
    argv, extra = sys.argv[1:], []
    if "--" in argv:
        cut = argv.index("--")
        argv, extra = argv[:cut], argv[cut + 1:]
    parser = argparse.ArgumentParser(
        prog="crew-run",
        description="无人值守运行 /crew：实时输出可读日志和心跳，运行记录存到日志目录。"
                    "默认跳过所有权限检查，只在信任的项目里用。「--」之后的参数原样传给 claude。",
        epilog="退出码：0 通过或已回答；1 未通过、无法验证或待确认；2 运行出错、超时、找不到 /crew、结果行不规范"
               "或同一目录已有 crew 在跑；130 手动中断。")
    parser.add_argument("task", nargs="+", help="任务描述；续跑时是你对问题的答复")
    parser.add_argument("--heartbeat", type=float, default=30, metavar="秒",
                        help="终端多久没有输出就打一行心跳（默认 30，0 表示不打）")
    parser.add_argument("--stall", type=float, default=10, metavar="分钟",
                        help="多久没有任何事件就提示可能卡住，只提示不终止（默认 10，0 表示不提示）")
    parser.add_argument("--timeout", type=float, default=60, metavar="分钟",
                        help="总时长上限，超过就终止（默认 60，0 表示不限）")
    parser.add_argument("--log-dir", metavar="目录",
                        help="日志根目录（默认 ~/.crew/runs；续跑时默认和原来那次放在一起）")
    parser.add_argument("--permission-mode", metavar="模式",
                        help="不跳过权限检查，改用这个权限模式，比如 auto")
    parser.add_argument("--resume", metavar="日志目录",
                        help="回答待确认的问题，接着那次运行的会话跑：在原来的项目目录里跑，"
                             "沿用原来的权限设置和「--」之后的参数")
    args = parser.parse_args(argv)
    if not shutil.which("claude"):
        print("crew-run：找不到 claude 命令", file=sys.stderr)
        return 2
    task, resumed_from, session, cost_base = " ".join(args.task), None, None, 0.0
    if args.resume:
        resumed_from = Path(os.path.abspath(Path(args.resume).expanduser()))
        prev = read_status(resumed_from / "status.json")
        session, cwd = prev.get("session_id"), prev.get("cwd")
        if not session or not cwd:
            print(f"crew-run：{args.resume} 里没有能接着跑的会话（status.json 里没有 session_id 或 cwd）",
                  file=sys.stderr)
            return 2
        try:
            os.chdir(cwd)  # 会话按项目目录存，换了目录 claude 找不到
        except OSError as exc:
            print(f"crew-run：进不了原来的项目目录 {cwd}：{exc.strerror}", file=sys.stderr)
            return 2
        task = "续：" + task
        args.permission_mode = args.permission_mode or prev.get("permission_mode")
        if not extra and isinstance(prev.get("claude_args"), list):
            extra = [str(arg) for arg in prev["claude_args"]]
        args.log_dir = args.log_dir or str(resumed_from.parent)
        base = prev.get("session_cost_usd", prev.get("cost_usd"))  # claude 续跑时报的费用是会话累计的
        cost_base = base if isinstance(base, (int, float)) else 0.0
    root = Path(os.path.abspath(Path(args.log_dir or "~/.crew/runs").expanduser()))
    busy = running_here(root, Path.cwd())
    if busy:
        print(f"crew-run：这个目录已经有 crew 在跑（日志 {home_short(busy)}），等它结束或者先停掉再跑", file=sys.stderr)
        return 2
    sys.stdout.reconfigure(errors="replace")
    signal.signal(signal.SIGTERM, signal.default_int_handler)  # 被 kill 时也走中断流程，顺手停掉 claude
    return Run(args, task, extra, root, resumed_from, session, cost_base).run()


if __name__ == "__main__":
    sys.exit(main())
